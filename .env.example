BOT_TOKEN=your_telegram_bot_token_here
ADMIN_ID=123456789
SERVER_IP=your_public_ip_or_domain
DB_PATH=/app/data/database.sqlite
PORT_RANGE_START=20000
PORT_RANGE_END=21000
TUNNEL_COST=150.0
TRAFFIC_LIMIT_GB=10
SUBSCRIPTION_DAYS=30

# 3X-UI Panel
XUI_HOST=http://127.0.0.1:2053
XUI_USERNAME=admin
XUI_PASSWORD=your_secure_password
XUI_INBOUND_ID=1

# VLESS Reality endpoint
XUI_SERVER_PORT=443
XUI_PUBLIC_KEY=your_reality_public_key
XUI_SHORT_ID=your_reality_short_id
XUI_SNI=yahoo.com
XUI_FINGERPRINT=chrome

# olcRTC Docker image
OLCRTC_IMAGE=olcrtc/srv:latest
